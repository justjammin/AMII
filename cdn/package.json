{
  "name": "amii-cdn",
  "private": true,
  "description": "Cloudflare Worker + R2 pull-through CDN for AMII meme images and audio.",
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir out/bundle",
    "mirror": "tsc -p . && node out/scripts/mirror.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
